# Same Mongo as the marketing site so SSO works
MONGODB_URI=
MONGODB_DB=saurabh

# Same secret as the marketing site (BYTE-IDENTICAL)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3010

# In production set to .saurabhbhayana.com (with leading dot). Leave blank in dev.
AUTH_COOKIE_DOMAIN=

# Backend the frontend calls for renders
NEXT_PUBLIC_API_URL=http://localhost:8001

# AES-256 key (32 bytes, base64) for encrypting user-stored Gemini keys.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_VAULT_SECRET=
