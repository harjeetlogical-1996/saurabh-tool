# ===== POV Reels MCP config =====
# Copy this file to ".env" and fill in your values.

# ---- Gemini / Veo (video + script + optional Gemini voice) ----
# Same key you use for nano-banana. If left blank, the server auto-reads
# ../nano-banana/api-key.txt. Get one at https://aistudio.google.com/apikey
# NOTE: Veo video generation is a PAID feature (billing must be enabled).
GEMINI_API_KEY=

# ---- Voice ----
# Free Edge-TTS voices: en-US-AriaNeural (warm F), en-US-GuyNeural (M),
# en-GB-RyanNeural (British M). Or a Gemini voice like "gemini:Kore" (paid).
POV_VOICE=en-US-AriaNeural
