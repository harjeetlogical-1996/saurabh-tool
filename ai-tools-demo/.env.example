# Gemini TTS (optional). If missing/invalid, server falls back to free Edge-TTS.
# Get a free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini TTS voice name (e.g. Kore, Puck, Charon, Aoede). Default: Kore
GEMINI_VOICE=Kore

# Edge-TTS fallback voice. Indian English: en-IN-NeerjaNeural / en-IN-PrabhatNeural
# Hindi: hi-IN-SwaraNeural / hi-IN-MadhurNeural
EDGE_VOICE=en-IN-NeerjaNeural
