# usa-leads config. Copy this file to ".env" and fill in your values.

# ===== LEAD SOURCES (you can use any/all) =====
# OpenStreetMap (source=osm) and Yellow Pages (source=yellowpages) need NO keys.
# These two are optional - only fill if you want google / yelp sources too.

# Google Cloud -> APIs -> enable "Places API (New)" -> create an API key.
GOOGLE_PLACES_API_KEY=

# Yelp Fusion API key (free): yelp.com/developers -> Create App -> copy API Key.
YELP_API_KEY=

# The email account that SENDS outreach, RECEIVES replies, and REPLIES from.
# Works with ANY provider (Hostinger custom domain, Gmail, Zoho, ...).
# A custom-domain email (e.g. contact@yourdomain.com) gets far better inbox
# delivery than a fresh Gmail, especially for cold outreach.
MAIL_ADDRESS=contact@yourdomain.com
MAIL_PASSWORD=
# SMTP (sending) + IMAP (reading) servers for your provider.
# Hostinger:  smtp.hostinger.com:465  /  imap.hostinger.com:993
# Gmail:      smtp.gmail.com:465      /  imap.gmail.com:993 (needs an App Password)
# Zoho:       smtp.zoho.com:465       /  imap.zoho.com:993
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993

# Shown as the sender name and in the opt-out footer.
SENDER_NAME=Saurabh Bhayana
SENDER_CITY=Jaipur, India

# OPTIONAL: where the daily summary email goes. Leave empty to send it to the
# outreach account above. Set to your personal Gmail to get reports there.
SUMMARY_EMAIL=saurabhbhayana1996@gmail.com

# OPTIONAL. Leave empty for now. When you create a free Calendly link later,
# paste it here and replies will automatically include it.
BOOKING_LINK=

# Safety: max cold emails per day (Gmail can suspend accounts that blast cold mail).
# Keep this low (40 or less) while warming up.
DAILY_SEND_CAP=40

# false = you approve every reply (recommended at first).
# true  = check_replies auto-sends replies. Flip only once you trust the copy.
FULL_AUTO_REPLY=false

# ===== HOSTING (only needed when running on a server like Render) =====
# Bearer token that protects your public MCP URL. Make it long + random.
# On Render, leave blank and let render.yaml generate it.
MCP_AUTH_TOKEN=
# The public https URL Render gives you (optional, for OAuth). Usually leave blank.
PUBLIC_URL=
# PORT is set automatically by Render. Leave blank locally.
PORT=

# ===== DAILY AUTO-RUN (the server works while your laptop is off) =====
# true = run the full pipeline once a day automatically.
AUTO_RUN=false
# Which leads to pull each day:
AUTO_CITY=Austin TX
AUTO_CATEGORY=plumbers
# Which source the daily job uses: osm (free, no key) / google / yelp / yellowpages / all
AUTO_SOURCE=osm
AUTO_FIND_LIMIT=20
AUTO_SEND_LIMIT=20
# Hour (UTC, 0-23) to run. 14 UTC = ~9am US Eastern, ~7:30pm India.
AUTO_HOUR_UTC=14
