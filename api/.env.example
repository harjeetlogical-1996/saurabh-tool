# Same Mongo as the marketing site
MONGODB_URI=
MONGODB_DB=saurabh

# Better Auth uses the saurabh.session_token cookie. We need to read it.
AUTH_COOKIE_PREFIX=saurabh

# AES-256 key (32 bytes, base64). MUST match the web app's KEY_VAULT_SECRET.
KEY_VAULT_SECRET=

# Where the frontend lives (used for CORS allowlist)
ALLOWED_ORIGINS=http://localhost:3010

# Local file storage during dev. In production switch to S3/R2.
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
