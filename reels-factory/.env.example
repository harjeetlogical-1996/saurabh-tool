# ===== Reels Factory MCP Server config =====
# Copy this file to ".env" and fill in your real values.

# ---- Pexels (free stock video/images) ----
# Get a free key at: https://www.pexels.com/api/
PEXELS_API_KEY=

# ---- Facebook (post + manage page) ----
# See FB-SETUP.md for full step-by-step (create page + get token).
# Facebook Page ID (the page you post + manage)
FB_PAGE_ID=
# Long-lived PAGE access token. Tip: run the fb_verify_token tool with a
# short token to discover your PAGE_ID and page token automatically.
FB_PAGE_ACCESS_TOKEN=

# ---- Voice ----
# Default English Edge-TTS voice. Options:
#   en-US-AriaNeural (female, warm)
#   en-US-GuyNeural (male)
#   en-GB-RyanNeural (British male)
#   en-US-JennyNeural (female, clear)
VOICE=en-US-AriaNeural
